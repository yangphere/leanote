# Copy this file to .env, then replace LEANOTE_APP_SECRET with fresh output from:
# openssl rand -base64 48
# Supported languages: de-de (Deutsch), en-us (English), es-co (Español),
# fr-fr (Français), pt-pt (Português), zh-cn (简体中文), zh-hk (繁體中文)
LEANOTE_LANGUAGE=zh-cn
MONGODB_URL=mongodb://mongo:27017/leanote
LEANOTE_APP_SECRET=REPLACE_WITH_OPENSSL_OUTPUT
LEANOTE_VERSION=0.0.0
LEANOTE_HTTP_PORT=9000
