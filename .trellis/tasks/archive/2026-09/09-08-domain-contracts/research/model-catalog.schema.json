{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanote.local/schemas/domain-model-catalog.v1.json",
  "title": "Leanote domain model catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "counts",
    "types",
    "commented_declarations",
    "collections",
    "api_variants",
    "decisions",
    "fixed_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "leanote.domain-model-catalog.v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "generated_from"],
      "properties": {
        "package": {"const": "app/info"},
        "generated_from": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "generated_at": {"type": "string", "minLength": 1}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_types", "commented_declarations", "business_collections", "api_actions"],
      "properties": {
        "active_types": {"const": 69},
        "commented_declarations": {"const": 3},
        "business_collections": {"type": "integer", "minimum": 28},
        "api_actions": {"const": 29}
      }
    },
    "types": {
      "type": "array",
      "minItems": 69,
      "items": {"$ref": "#/$defs/type"}
    },
    "commented_declarations": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/commentedDeclaration"}
    },
    "collections": {
      "type": "array",
      "minItems": 28,
      "items": {"$ref": "#/$defs/collection"}
    },
    "api_variants": {
      "type": "array",
      "items": {"$ref": "#/$defs/apiVariant"}
    },
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "fixed_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1}
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "primary_role",
        "secondary_roles",
        "consumer_status",
        "consumers",
        "source",
        "fields",
        "fixtures"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9_]*$"},
        "status": {"const": "active"},
        "primary_role": {
          "enum": [
            "persistence",
            "api_dto",
            "request_input",
            "template_projection",
            "internal_projection",
            "value_type"
          ]
        },
        "secondary_roles": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "consumer_status": {"enum": ["confirmed", "unknown"]},
        "consumers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "source": {"$ref": "#/$defs/sourceRef"},
        "fields": {
          "type": "array",
          "items": {"$ref": "#/$defs/field"}
        },
        "fixtures": {"$ref": "#/$defs/fixtureStatus"}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "wire", "bson", "persistence_state"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/sourceRef"},
        "wire": {
          "type": "object",
          "additionalProperties": false,
          "required": ["json_name", "null_behavior"],
          "properties": {
            "json_name": {"type": ["string", "null"]},
            "null_behavior": {"type": "string", "minLength": 1},
            "json_embedded": {"type": "boolean"},
            "json_embedded_names": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "bson": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "tag_source", "omitempty"],
          "properties": {
            "tag": {"type": ["string", "null"]},
            "tag_source": {"const": "app/info struct tag"},
            "omitempty": {"type": "boolean"}
          }
        },
        "persistence_state": {
          "enum": ["read_write", "write_only", "read_only", "projection_only", "unknown", "not_applicable"]
        }
      }
    },
    "fixtureStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json", "bson", "binder", "status"],
      "properties": {
        "json": {"enum": ["present", "missing", "unknown", "not_applicable"]},
        "bson": {"enum": ["present", "missing", "unknown", "not_applicable"]},
        "binder": {"enum": ["present", "missing", "unknown", "not_applicable"]},
        "status": {"enum": ["complete", "partial", "unknown"]}
      }
    },
    "commentedDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "reason"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9_]*$"},
        "source": {"$ref": "#/$defs/sourceRef"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model", "status", "evidence", "unique_indexes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]},
        "status": {"enum": ["read_write", "declared_only", "unknown"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "unique_indexes": {
          "type": "array",
          "items": {"$ref": "#/$defs/index"}
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "status", "evidence"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "status": {"enum": ["confirmed", "historical_intent", "unknown"]},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "apiVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "action", "request", "success", "failure", "evidence_status"],
      "properties": {
        "route": {"type": "string", "pattern": "^/api/.+"},
        "action": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9_]*\\.[A-Z][A-Za-z0-9_]*$"},
        "method": {"enum": ["GET", "POST", "PUT", "DELETE", "PATCH"]},
        "auth": {"enum": ["required", "not_required", "unknown"]},
        "request": {"type": "object"},
        "success": {"type": "object"},
        "failure": {"type": "object"},
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_status": {"enum": ["confirmed", "partial", "unknown"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "question", "decision", "impact", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^D-(0[1-46])$"},
        "status": {"const": "decided"},
        "question": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
