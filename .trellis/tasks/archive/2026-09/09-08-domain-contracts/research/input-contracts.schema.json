{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanote.local/schemas/domain-input-contracts.v1.json",
  "title": "Leanote request binding input contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "contracts"],
  "properties": {
    "schema_version": {"const": "leanote.domain-input-contracts.v1"},
    "source": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "contracts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contract"}}
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "fields", "runtime_unknowns"],
      "properties": {
        "type": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9_]*$"},
        "source": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "runtime_unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "go_type", "wire_name", "required", "nullable", "notes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "go_type": {"type": "string", "minLength": 1},
        "wire_name": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "required_in": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "nullable": {"type": "boolean"},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
