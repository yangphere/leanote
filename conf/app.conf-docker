[prod]
db.urlEnv=${MONGODB_URL}
db.dbname=leanote
app.secret=${LEANOTE_APP_SECRET}
adminEmail=${LEANOTE_ADMIN_EMAIL}
adminInitialPassword=${LEANOTE_ADMIN_INITIAL_PASSWORD}
adminForceEnvPassword=${LEANOTE_ADMIN_FORCE_ENV_PASSWORD}
i18n.default_language=${LEANOTE_LANGUAGE}
http.addr=0.0.0.0
http.port=9000
site.url=${LEANOTE_SITE_URL}
session.expires=${LEANOTE_SESSION_EXPIRES}
content.private.data=/var/lib/leanote/private/files
content.private.quarantine=/var/lib/leanote/private/quarantine
content.public.data=/var/lib/leanote/public/upload
content.public.quarantine=/var/lib/leanote/public/quarantine
content.temporary=/var/lib/leanote/tmp
admin.backup.root=/var/lib/leanote/backup
pdf.renderer=gotenberg
pdf.gotenberg.url=http://gotenberg:3000
